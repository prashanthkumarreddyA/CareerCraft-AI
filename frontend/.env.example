# Copy to frontend/.env.local for local development. Never commit .env.local.
# Everything prefixed with VITE_ is compiled into the public JavaScript bundle:
# put NO secrets here (no Gemini, Cloudinary or database credentials).

# Base URL of the backend API, including /api, no trailing slash.
# Local:      http://localhost:5000/api
# Production: https://your-backend.onrender.com/api   (set in Netlify > Site settings > Environment variables)
VITE_API_URL=http://localhost:5000/api
