# Copy to backend/.env for local development. Never commit backend/.env.
# On Render, set these in the service's Environment settings instead.

# --- Server -----------------------------------------------------------------
NODE_ENV=development
# Render injects PORT automatically; 5000 is the local default.
PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated, no trailing slash.
# Production: your Netlify URL only, e.g. https://your-site.netlify.app
CLIENT_URL=http://localhost:5180,http://localhost:4180
# Number of reverse proxies in front of the app (Render = 1). Used for client IPs in rate limiting.
TRUST_PROXY=0
LOG_LEVEL=info

# --- Rate limiting (requests per window per IP) ----------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- MongoDB Atlas (required in production) ---------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/resume-builder

# --- Auth (used from Phase 3) -------------------------------------------------
# Long random string, at least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- Google Gemini (used from Phase 4; backend only) ------------------------
# Key from https://aistudio.google.com/apikey. Never put it in the frontend.
GEMINI_API_KEY=
# Model id as listed by the Gemini API (no "models/" prefix). Check it with: npm run smoke:gemini
# Older ids can be listed but refuse generation ("no longer available to new users").
GEMINI_MODEL=
# Optional comma-separated models tried when the primary one is retired, overloaded or times out.
GEMINI_FALLBACK_MODELS=
# Optional reasoning depth for models that support it: LOW, MEDIUM or HIGH (empty = model default).
GEMINI_THINKING_LEVEL=
# Per-attempt timeout, whole-request budget (retries + fallbacks) and attempts per model.
GEMINI_TIMEOUT_MS=90000
GEMINI_TOTAL_TIMEOUT_MS=170000
GEMINI_MAX_ATTEMPTS=3

# --- Cloudinary (used from Phase 3; private/authenticated delivery) ---------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Lifetime of signed download links, in seconds.
SIGNED_URL_TTL_SECONDS=300

# --- Uploads & hashing --------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5
# bcrypt cost factor for password hashing (10-13 is reasonable; higher is slower)
BCRYPT_ROUNDS=12
