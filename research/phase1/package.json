{
  "name": "phase1-template-research",
  "private": true,
  "type": "module",
  "description": "Phase 1: extract the master resume and validate the template-based PDF renderer against the original.",
  "scripts": {
    "extract": "node extract.mjs original-resume.pdf output/master-resume.json output/extracted-lines.json",
    "render": "node render.mjs output/master-resume.json output/generated-resume.pdf",
    "validate": "python validate.py original-resume.pdf output/generated-resume.pdf output"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38"
  }
}
